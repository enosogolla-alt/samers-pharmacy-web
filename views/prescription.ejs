<%- include('partials/header') %> <%- include('partials/navbar') %>

<section class="max-w-7xl mx-auto px-6 pt-8">
  <nav class="text-sm text-ink-900/50 mb-4">
    <a href="/" class="hover:text-forest-700">Home</a>
    <span class="mx-1">&rsaquo;</span>
    <span class="text-ink-900">Upload Prescription</span>
  </nav>
  <h1 class="font-display text-3xl md:text-4xl font-semibold text-ink-900 mb-2">
    Upload Your Prescription
  </h1>
  <p class="text-ink-900/60 max-w-xl">
    Upload a clear photo or scan of your prescription. Our licensed pharmacists
    will verify it and prepare your order.
  </p>
</section>

<section class="max-w-4xl mx-auto px-6 pt-10">
  <div class="bg-white border border-mint-200 rounded-3xl p-6 md:p-8 mb-8">
    <h2 class="font-display text-lg font-semibold text-ink-900 mb-1">Already submitted a prescription?</h2>
    <p class="text-sm text-ink-900/60 mb-4">Enter the phone number you used to find your submission(s) and check their status.</p>
    <form action="/prescription/lookup" method="GET" class="flex flex-col sm:flex-row gap-3">
      <input type="tel" name="phone" required value="<%= lookupPhone %>" placeholder="+254 7XX XXX XXX" class="flex-1 px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20">
      <button type="submit" class="px-6 py-2.5 rounded-capsule bg-forest-700 text-white font-semibold text-sm hover:bg-ink-900 transition-colors whitespace-nowrap">Find My Prescriptions</button>
    </form>

    <% if (lookupResults !== null) { %>
      <div class="mt-5 pt-5 border-t border-mint-200">
        <% if (lookupResults.length === 0) { %>
          <p class="text-sm text-ink-900/50">No prescriptions found for that phone number.</p>
        <% } else { %>
          <ul class="space-y-2">
            <% lookupResults.forEach(function(p) { %>
              <li>
                <a href="/prescription/track/<%= p.id %>" class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl bg-mint-50 hover:bg-mint-200/60 transition-colors">
                  <span class="text-sm text-ink-900">
                    <span class="font-medium">Ref #<%= p.id.slice(0, 8).toUpperCase() %></span>
                    <span class="text-ink-900/50"> &middot; <%= p.createdAt.toLocaleDateString('en-KE', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                  </span>
                  <span class="text-xs font-semibold text-forest-700 uppercase tracking-wide"><%= p.status.replace(/_/g, ' ') %></span>
                </a>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<section class="max-w-4xl mx-auto px-6 pb-10" x-data="{ fileName: null }">

  <% if (success) { %>
    <div class="bg-forest-700/10 border border-forest-700/30 rounded-2xl p-5 mb-8 flex items-center gap-3">
      <svg class="w-5 h-5 text-forest-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      <p class="text-sm font-medium text-ink-900">Your prescription has been submitted. Our pharmacist team will verify it shortly.</p>
    </div>
  <% } %>
 <form action="/prescription" method="POST" enctype="multipart/form-data" class="bg-white border border-mint-200 rounded-3xl p-8 md:p-10">
    <!-- Upload / Type toggle -->
    <div x-data="{ mode: 'upload' }">
      <input type="hidden" name="mode" :value="mode">
      <div class="flex gap-2 mb-4 p-1 bg-mint-50 rounded-capsule w-fit">
        <button
          @click="mode = 'upload'"
          class="px-5 py-2 rounded-capsule text-sm font-semibold transition-colors"
          :class="mode === 'upload' ? 'bg-forest-700 text-white' : 'text-ink-900/60'"
        >
          Upload File
        </button>
        <button
          @click="mode = 'type'"
          class="px-5 py-2 rounded-capsule text-sm font-semibold transition-colors"
          :class="mode === 'type' ? 'bg-forest-700 text-white' : 'text-ink-900/60'"
        >
          Type it Instead
        </button>
      </div>

      <label
        x-show="mode === 'upload'"
        class="block border-2 border-dashed border-mint-200 rounded-2xl h-64 flex flex-col items-center justify-center gap-3 cursor-pointer hover:border-forest-700 transition-colors mb-8"
      >
        <input type="file" name="prescriptionFile" accept="image/*,.pdf" class="hidden" @change="fileName = $event.target.files[0]?.name">
        <span
          class="w-14 h-14 rounded-full bg-mint-50 flex items-center justify-center"
        >
          <svg
            class="w-7 h-7 text-forest-700"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 16V4m0 0L7 9m5-5l5 5M5 20h14"
            />
          </svg>
        </span>
        <p
          class="text-ink-900 font-medium"
          x-text="fileName || 'Click to upload or drag and drop'"
        ></p>
        <p class="text-xs text-ink-900/50">
          JPG, PNG, or PDF &middot; Max 10MB
        </p>
      </label>

      <div x-show="mode === 'type'" x-cloak class="mb-8">
        <textarea name="typedContent" rows="6" placeholder="Type your prescription details here, e.g. medicine name, dosage, and doctor's instructions..." class="w-full px-4 py-3 rounded-2xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20"></textarea>
      </div>
    </div>

    <!-- Delivery details -->
    <div class="grid md:grid-cols-2 gap-5 mb-6">
      <div>
        <label class="block text-sm font-medium text-ink-900 mb-1.5"
          >Full Name</label
        >
        <input
          type="text"
          name="fullName" required
          placeholder=""
          class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-ink-900 mb-1.5"
          >Phone Number</label
        >
        <input
          type="tel"
          name="phone" required
          placeholder="+254 7XX XXX XXX"
          class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20"
        />
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-ink-900 mb-1.5"
          >Delivery Address</label
        >
        <input
          type="text"
          name="deliveryAddress" required
          placeholder="e.g. Elgon View, Eldoret"
          class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20"
        />
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-medium text-ink-900 mb-1.5"
          >Additional Notes
          <span class="text-ink-900/40 font-normal">(optional)</span></label
        >
        <textarea
          rows="3"
          name="notes"
          placeholder="Any special instructions for our pharmacist..."
          class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20"
        ></textarea>
      </div>
    </div>

    <button type="submit" class="w-full py-3.5 rounded-capsule bg-forest-700 text-white font-semibold hover:bg-ink-900 transition-colors">
      Submit Prescription
    </button>
  </form>

  <!-- Trust row -->
  <div class="grid grid-cols-3 gap-4 mt-10">
    <div class="flex flex-col items-center text-center gap-2">
      <span
        class="w-11 h-11 rounded-full bg-forest-700/10 flex items-center justify-center"
      >
        <svg
          class="w-5 h-5 text-forest-700"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12.75L11.25 15 15 9.75M21 12c0 4.556-3.04 8.582-7.5 9.75C9.04 20.582 6 16.556 6 12V6.5l6-3 6 3V12z"
          />
        </svg>
      </span>
      <span class="text-xs font-medium text-ink-900">Pharmacist Verified</span>
    </div>
    <div class="flex flex-col items-center text-center gap-2">
      <span
        class="w-11 h-11 rounded-full bg-forest-700/10 flex items-center justify-center"
      >
        <svg
          class="w-5 h-5 text-forest-700"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
          />
        </svg>
      </span>
      <span class="text-xs font-medium text-ink-900">Fast Delivery</span>
    </div>
    <div class="flex flex-col items-center text-center gap-2">
      <span
        class="w-11 h-11 rounded-full bg-forest-700/10 flex items-center justify-center"
      >
        <svg
          class="w-5 h-5 text-forest-700"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.8"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
          />
        </svg>
      </span>
      <span class="text-xs font-medium text-ink-900"
        >Secure &amp; Confidential</span
      >
    </div>
  </div>
</section>

<%- include('partials/bottom-nav') %> <%- include('partials/footer') %>
