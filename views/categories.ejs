<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="max-w-7xl mx-auto px-6 pt-8">
  <nav class="text-sm text-ink-900/50 mb-4">
    <a href="/" class="hover:text-forest-700">Home</a> <span class="mx-1">&rsaquo;</span> <span class="text-ink-900">Shop by Category</span>
  </nav>
  <h1 class="font-display text-3xl md:text-4xl font-semibold text-ink-900 mb-2">Shop by Category</h1>
  <p class="text-ink-900/60 max-w-xl">Browse our wide range of health and wellness products. From pain relief to vitamins, we have everything you need for your health.</p>
</section>

<section class="max-w-7xl mx-auto px-6 py-10">
  <% if (categories.length === 0) { %>
    <p class="text-ink-900/50 text-sm">No categories yet — check back soon.</p>
  <% } else { %>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
    <% const bgPalette = ['bg-mint-50', 'bg-[#FDF3E3]', 'bg-[#FBEAF0]', 'bg-[#EAF1FB]', 'bg-[#F1EEFB]', 'bg-[#EAFBF3]']; %>
    <% const fallbackIcon = 'M9 12h3.75M9 15h3.75M3.75 5.25h6.5v6.5h-6.5v-6.5z'; %>
    <% const iconsBySlug = {
      'medicines': 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082M9.75 3.104a24.301 24.301 0 014.5 0M14.25 3.104v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5',
      'vitamins-supplements': 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z',
      'skincare-beauty': 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z',
      'mother-baby': 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
      'medical-devices': 'M9 3v2m6-2v2M4 8h16M5 8v11a2 2 0 002 2h10a2 2 0 002-2V8H5z',
      'personal-care': 'M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z',
    }; %>
    <% categories.forEach(function(cat, i) { %>
     <a href="/category/<%= cat.slug %>" class="<%= bgPalette[i % bgPalette.length] %> rounded-2xl p-4 md:p-5 flex items-center justify-between gap-2 hover:shadow-md transition-shadow group min-w-0">
        <div class="flex items-center gap-2 md:gap-3 min-w-0">
          <span class="w-10 h-10 md:w-11 md:h-11 rounded-xl bg-white flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-forest-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="<%= iconsBySlug[cat.slug] || fallbackIcon %>"/></svg>
          </span>
          <span class="font-semibold text-ink-900 text-xs md:text-sm leading-snug break-words min-w-0"><%= cat.name %></span>
        </div>
        <svg class="w-4 h-4 text-ink-900/30 group-hover:text-forest-700 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    <% }); %>
  </div>
  <% } %>
</section>

<%- include('partials/bottom-nav') %>
<%- include('partials/footer') %>