    <div class="relative z-10 max-w-2xl">
      <span class="inline-block px-3 py-1 rounded-capsule bg-mint-400/15 text-mint-400 text-xs font-semibold mb-4">Expert Guidance</span>
      <h2 class="font-display text-2xl md:text-3xl font-semibold text-white mb-4">
        Talk to a Health Expert — Online or In-Store
      </h2>
      <p class="text-white/70 mb-8 max-w-xl">
