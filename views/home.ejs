<%- include('partials/header') %> <%- include('partials/navbar') %>

<% if (googleLinkNotice) { %>
  <section class="max-w-7xl mx-auto px-6 pt-6">
    <div class="bg-forest-700/10 border border-forest-700/30 rounded-2xl p-4 flex items-center gap-3">
      <svg class="w-5 h-5 text-forest-700 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/></svg>
      <p class="text-sm font-medium text-ink-900">This Google sign-in was linked to your existing account.</p>
    </div>
  </section>
<% } %>

<!-- ============ PROMO CAROUSEL ============ -->
<section class="max-w-7xl mx-auto px-5 md:px-6 pt-6 md:pt-8 pb-10 md:pb-16" x-data="{ slide: 0, slides: 3 }" x-init="setInterval(() => slide = (slide + 1) % slides, 4000)">
  <div class="relative rounded-3xl overflow-hidden h-40 md:h-80">

    <div class="absolute inset-0 flex transition-transform duration-700 ease-in-out" :style="`transform: translateX(-${slide * 100}%)`">

      <div class="min-w-full h-full relative overflow-hidden bg-gradient-to-br from-forest-700 to-[#6B21C9] md:bg-none md:bg-forest-700 flex items-center px-6 md:px-16">
        <div class="absolute -right-5 -top-5 w-36 h-36 rounded-full bg-white/[0.06] md:hidden"></div>
        <div class="relative z-10">
          <span class="inline-block px-2.5 py-1 rounded-capsule bg-white/15 text-mint-400 text-[10px] md:text-xs font-semibold mb-2 md:mb-3">Limited Offer</span>
          <h3 class="font-display text-lg md:text-3xl text-white font-semibold mb-1 md:mb-2 leading-tight">Up to 15% off vitamins</h3>
          <p class="text-white/70 text-xs md:text-base">Boost your immunity this season</p>
        </div>
      </div>

      <div class="min-w-full h-full relative overflow-hidden bg-gradient-to-br from-ink-900 to-[#3A2A5C] md:bg-none md:bg-ink-900 flex items-center px-6 md:px-16">
        <div class="absolute -right-5 -top-5 w-36 h-36 rounded-full bg-white/[0.06] md:hidden"></div>
        <div class="relative z-10">
          <span class="inline-block px-2.5 py-1 rounded-capsule bg-gold-500/20 text-gold-500 text-[10px] md:text-xs font-semibold mb-2 md:mb-3">New</span>
          <h3 class="font-display text-lg md:text-3xl text-white font-semibold mb-1 md:mb-2 leading-tight">Home lab sample collection</h3>
          <p class="text-white/70 text-xs md:text-base">Book a test, we come to you</p>
        </div>
      </div>

      <div class="min-w-full h-full relative overflow-hidden bg-gradient-to-br from-mint-400 to-[#7C3AC9] md:bg-none md:bg-mint-400 flex items-center px-6 md:px-16">
        <div class="absolute -right-5 -top-5 w-36 h-36 rounded-full bg-white/10 md:hidden"></div>
        <div class="relative z-10">
          <span class="inline-block px-2.5 py-1 rounded-capsule bg-ink-900/10 text-ink-900 text-[10px] md:text-xs font-semibold mb-2 md:mb-3">Free Delivery</span>
          <h3 class="font-display text-lg md:text-3xl text-ink-900 font-semibold mb-1 md:mb-2 leading-tight">On orders above KSh 2,500</h3>
          <p class="text-ink-900/70 text-xs md:text-base">Nationwide, fast and reliable</p>
        </div>
      </div>

    </div>

    <div class="absolute bottom-3 md:bottom-5 left-1/2 -translate-x-1/2 flex gap-1.5 md:gap-2">
      <template x-for="i in slides">
        <button @click="slide = i - 1" class="h-1.5 md:h-2 rounded-full transition-all" :class="slide === i - 1 ? 'bg-white w-5 md:w-6' : 'bg-white/40 w-1.5 md:w-2'"></button>
      </template>
    </div>
  </div>
</section>

<!-- ============ BRAND STATEMENT ============ -->
<section class="max-w-4xl mx-auto px-6 py-14 text-center">
  <div class="flex items-center justify-center gap-2 mb-5">
    <img src="/images/logo-icon.png" alt="Samers Pharmacy" class="w-10 h-10 object-contain mix-blend-multiply">
    <span class="font-display font-semibold text-xl text-forest-700">Samers Pharmacy</span>
  </div>
  <p class="text-gold-500 font-semibold tracking-wide uppercase text-sm mb-4">Quality Health Is Our Priority</p>
  <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink-900 leading-snug">
    Trusted care, delivered with precision — because your health deserves nothing less than genuine medicine, real expertise, and a pharmacy that shows up.
  </h2>
</section>

<!-- ============ TODAY'S OFFERS ============ -->
<section class="max-w-7xl mx-auto px-5 md:px-6 py-3 md:py-4 pb-10 md:pb-16" x-data="{}">
  <div class="flex items-end justify-between mb-5 md:mb-8">
    <div>
      <h2 class="font-display text-lg md:text-3xl font-semibold text-ink-900">Today's Offers</h2>
      <p class="text-ink-900/60 mt-0.5 md:mt-1 text-xs md:text-base">Genuine products, real savings</p>
    </div>
    <a href="/products" class="text-forest-700 font-semibold text-xs md:text-sm flex items-center gap-1 hover:text-ink-900 shrink-0">
      View All
      <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <!-- Mobile: compact cards with quick-add -->
  <div class="md:hidden grid grid-cols-2 gap-3">
    <% offers.forEach(function(item) { %>
      <a href="/product/<%= item.slug %>" class="bg-white rounded-2xl p-3 shadow-sm flex flex-col">
        <div class="relative rounded-xl h-[100px] mb-2.5 flex items-center justify-center overflow-hidden" style="background: radial-gradient(circle at 50% 40%, #ffffff 0%, #F3F0FA 100%);">
          <% if (item.discountLabel) { %><span class="absolute top-2 left-2 px-2 py-0.5 rounded-capsule bg-coral-500 text-white text-[9px] font-bold"><%= item.discountLabel %></span><% } %>
          <% if (item.imageUrl) { %>
            <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="w-full h-full object-contain p-3">
          <% } else { %>
            <svg class="w-8 h-8 text-mint-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M3.75 5.25h6.5v6.5h-6.5v-6.5z"/></svg>
          <% } %>
        </div>
        <% if (item.category) { %><span class="text-[10px] font-semibold text-forest-700 mb-0.5"><%= item.category.name %></span><% } %>
        <p class="text-xs font-medium text-ink-900 mb-2 leading-snug flex-1"><%= item.name %></p>
        <div class="flex items-center justify-between">
          <span class="text-sm font-bold text-gold-500 whitespace-nowrap">KSh <%= item.price %></span>
          <button
            @click.stop.prevent="addToCart({ id: '<%= item.id %>', name: '<%= item.name.replace(/'/g, "\\'") %>', price: <%= item.price %>, imageUrl: '<%= item.imageUrl || '' %>', qty: 1 })"
            aria-label="Add to cart"
            class="w-7 h-7 rounded-lg bg-forest-700 hover:bg-ink-900 transition-colors flex items-center justify-center shrink-0"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          </button>
        </div>
      </a>
    <% }); %>
  </div>

  <!-- Desktop: existing full card layout -->
  <div class="hidden md:grid md:grid-cols-4 gap-5 items-stretch">
    <% offers.forEach(function(item) { %>
      <a href="/product/<%= item.slug %>" class="bg-white border border-mint-200 rounded-2xl p-4 hover:shadow-md transition-shadow flex flex-col h-full">
        <div class="relative rounded-xl h-44 mb-5 flex items-center justify-center overflow-hidden" style="background: radial-gradient(circle at 50% 40%, #ffffff 0%, #F3F8F5 65%, #E9F7F2 100%);">
          <% if (item.discountLabel) { %><span class="absolute top-3 left-3 px-2.5 py-1 rounded-capsule bg-coral-500 text-white text-[10px] font-bold"><%= item.discountLabel %></span><% } %>
         <% if (item.imageUrl) { %>
            <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="w-full h-full object-contain p-4">
          <% } else { %>
            <svg class="w-14 h-14 text-mint-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M3.75 5.25h6.5v6.5h-6.5v-6.5z"/></svg>
          <% } %>
        </div>
        <p class="text-sm font-medium text-ink-900 mb-2 leading-snug flex-1"><%= item.name %></p>
        <div class="flex items-baseline gap-1.5 mb-3 flex-wrap">
          <span class="text-gold-500 font-bold whitespace-nowrap">KSh <%= item.price %></span>
          <span class="text-ink-900/40 text-xs line-through whitespace-nowrap">KSh <%= item.oldPrice %></span>
        </div>
        <button
          @click.stop.prevent="addToCart({ id: '<%= item.id %>', name: '<%= item.name.replace(/'/g, "\\'") %>', price: <%= item.price %>, imageUrl: '<%= item.imageUrl || '' %>', qty: 1 })"
          class="block text-center w-full py-2 rounded-capsule bg-forest-700 text-white text-sm font-semibold hover:bg-ink-900 transition-colors"
        >Add to Cart</button>
      </a>
    <% }); %>
  </div>
</section>

<!-- ============ SHOP BY CATEGORY ============ -->
<section class="max-w-7xl mx-auto px-5 md:px-6 py-10 md:py-16">
  <div class="flex items-end justify-between mb-5 md:mb-8">
    <div>
      <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink-900">Shop by Category</h2>
      <p class="text-ink-900/60 mt-1">Browse our wide range of healthcare products</p>
    </div>
    <a href="/products" class="text-forest-700 font-semibold text-sm flex items-center gap-1 hover:text-ink-900">
      View All
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <% const homeFallbackIcon = 'M9 12h3.75M9 15h3.75M3.75 5.25h6.5v6.5h-6.5v-6.5z'; %>
  <% const homeIconsBySlug = {
    'medicines': 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082M9.75 3.104a24.301 24.301 0 014.5 0M14.25 3.104v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5',
    'vitamins-supplements': 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z',
    'skincare-beauty': 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z',
    'mother-baby': 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
    'medical-devices': 'M9 3v2m6-2v2M4 8h16M5 8v11a2 2 0 002 2h10a2 2 0 002-2V8H5z',
    'personal-care': 'M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z',
  }; %>

  <!-- Mobile: compact scrollable icon chips -->
  <div class="md:hidden flex gap-4 overflow-x-auto pb-1 -mx-5 px-5" style="scrollbar-width: none;">
    <% categories.forEach(function(cat) { %>
      <a href="/category/<%= cat.slug %>" class="shrink-0 w-[68px] flex flex-col items-center gap-2 text-center">
        <span class="w-14 h-14 rounded-2xl bg-white shadow-sm flex items-center justify-center">
          <svg class="w-[22px] h-[22px] text-forest-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="<%= homeIconsBySlug[cat.slug] || homeFallbackIcon %>"/></svg>
        </span>
        <span class="text-[11px] font-medium text-ink-900 leading-tight"><%= cat.name %></span>
      </a>
    <% }); %>
  </div>

  <!-- Desktop: existing bordered card grid -->
  <div class="hidden md:grid md:grid-cols-4 lg:grid-cols-6 gap-4">
    <% categories.forEach(function(cat) { %>
      <a href="/category/<%= cat.slug %>" class="group bg-white border border-mint-200 rounded-2xl p-5 flex flex-col items-center text-center gap-3 hover:border-forest-700 hover:shadow-md transition-all">
        <span class="w-12 h-12 rounded-full bg-mint-50 flex items-center justify-center group-hover:bg-forest-700 transition-colors">
          <svg class="w-6 h-6 text-forest-700 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="<%= homeIconsBySlug[cat.slug] || homeFallbackIcon %>"/></svg>
        </span>
        <span class="text-sm font-medium text-ink-900"><%= cat.name %></span>
      </a>
    <% }); %>
  </div>
</section>

<!-- ============ HERO ============ -->
<section class="bg-ink-900 relative overflow-hidden">
  <div
    class="max-w-7xl mx-auto px-6 py-16 md:py-24 grid md:grid-cols-2 gap-10 items-center"
  >
    <div class="relative z-10">
      <span
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-capsule bg-white/10 text-mint-400 text-xs font-semibold tracking-wide uppercase mb-6"
      >
        <svg
          class="w-3.5 h-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M5 13l4 4L19 7"
          />
        </svg>
        Licensed Pharmacy &middot; Kenya
      </span>

      <h1
        class="font-display text-4xl md:text-5xl lg:text-6xl font-semibold text-white leading-tight mb-5"
      >
        Your health,<br />delivered with care.
      </h1>

      <p class="text-white/70 text-base md:text-lg mb-8 max-w-md">
        Genuine medicines, diagnostic tests, and expert pharmacist support —
        ordered online, delivered nationwide.
      </p>

      <div class="flex flex-wrap gap-4">
        <a
          href="/products"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-capsule bg-forest-700 text-white font-semibold hover:bg-mint-400 hover:text-ink-900 transition-colors"
        >
          Shop Medicines
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"
            />
          </svg>
        </a>
        <a
          href="/prescription"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-capsule border border-white/30 text-white font-semibold hover:bg-white/10 transition-colors"
        >
          Upload Prescription
        </a>
      </div>
    </div>

    <div class="relative z-10">
      <div class="grid grid-cols-2 gap-4">
        <div
          class="bg-forest-700 rounded-3xl p-6 flex flex-col justify-between h-40"
        >
          <svg
            class="w-7 h-7 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12h3.75M9 15h3.75M3.75 5.25h6.5v6.5h-6.5v-6.5z"
            />
          </svg>
          <p class="text-white font-semibold text-sm">
            Fast prescription approval
          </p>
        </div>
        <div
          class="bg-mint-400 rounded-3xl p-6 flex flex-col justify-between h-40 "
        >
          <svg
            class="w-7 h-7 text-ink-900"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 12h4l2-7 4 14 2-7h6"
            />
          </svg>
          <p class="text-ink-900 font-semibold text-sm">
            Book lab tests online
          </p>
        </div>
        <div
          class="bg-white/10 rounded-3xl p-6 flex flex-col justify-between h-40 col-span-2"
        >
          <div class="flex items-center justify-between">
            <svg
              class="w-7 h-7 text-gold-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M20 12a8 8 0 11-16 0 8 8 0 0116 0zM9 12l2 2 4-4"
              />
            </svg>
            <span
              class="text-xs font-semibold px-3 py-1 rounded-capsule bg-gold-500 text-ink-900"
              >Nationwide</span
            >
          </div>
          <p class="text-white font-semibold text-sm">
            Same-day delivery in Nairobi, next-day countrywide
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FEATURED PRODUCTS ============ -->
<section class="max-w-7xl mx-auto px-6 py-16">
  <div class="flex items-end justify-between mb-8">
    <div>
      <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink-900">Featured Products</h2>
      <p class="text-ink-900/60 mt-1">Handpicked essentials, trusted by our customers</p>
    </div>
    <a href="/products" class="text-forest-700 font-semibold text-sm flex items-center gap-1 hover:text-ink-900">
      View All
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
    </a>
  </div>

  <div class="flex gap-5 overflow-x-auto pb-4 -mx-6 px-6 snap-x snap-mandatory" style="scrollbar-width: none;">
    <% featuredProducts.forEach(function(item) { %>
      <a href="/product/<%= item.slug %>" class="min-w-[240px] snap-start bg-white border border-mint-200 rounded-2xl p-5 hover:shadow-lg transition-shadow">
        <div class="relative rounded-xl h-40 mb-4 flex items-center justify-center overflow-hidden" style="background: radial-gradient(circle at 50% 40%, #ffffff 0%, #F3F8F5 65%, #E9F7F2 100%);">
          <% if (item.imageUrl) { %>
            <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="w-full h-full object-contain p-4">
          <% } else { %>
            <svg class="w-12 h-12 text-mint-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M3.75 5.25h6.5v6.5h-6.5v-6.5z"/></svg>
          <% } %>
        </div>
        <div class="flex items-center gap-1 mb-1.5">
          <svg class="w-3.5 h-3.5 text-gold-500" fill="currentColor" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
          <span class="text-xs text-ink-900/60"><%= item.rating %></span>
        </div>
        <p class="text-sm font-medium text-ink-900 mb-3 leading-snug"><%= item.name %></p>
        <div class="flex items-center justify-between">
          <span class="text-forest-700 font-bold text-sm">KSh <%= item.price %></span>
          <span class="px-4 py-2 rounded-capsule bg-forest-700 text-white text-xs font-semibold hover:bg-ink-900 transition-colors">
            Add to Cart
          </span>
        </div>
      </a>
    <% }); %>
  </div>
</section>

<!-- ============ PRESCRIPTION UPLOAD ============ -->
<section class="max-w-7xl mx-auto px-6 py-16">
  <div class="bg-mint-50 rounded-3xl p-8 md:p-12 grid md:grid-cols-2 gap-10 items-center">

    <div>
      <span class="inline-block px-3 py-1 rounded-capsule bg-forest-700/10 text-forest-700 text-xs font-semibold mb-4">Easy &amp; Secure</span>
      <h2 class="font-display text-2xl md:text-3xl font-semibold text-ink-900 mb-4">Have a Prescription?</h2>
      <p class="text-ink-900/70 mb-6 max-w-md">
        Upload your doctor's prescription and let us handle the rest. We'll verify, prepare, and deliver your medication to your doorstep.
      </p>

      <ul class="space-y-3 mb-8">
        <li class="flex items-center gap-3 text-sm text-ink-900">
          <span class="w-5 h-5 rounded-full bg-forest-700/15 flex items-center justify-center">
