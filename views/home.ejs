      </p>

      <div class="flex flex-wrap gap-3 mb-9">
        <% const topics = ['Chronic Conditions', 'Mental Health', 'Skin & Dermatology', 'Healthy Lifestyle', 'Nutrition', 'Health Goals']; %>
