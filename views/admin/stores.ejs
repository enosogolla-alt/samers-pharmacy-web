<%- include('../partials/header') %>

<body class="bg-mint-50">
<div class="flex">
  <%- include('../partials/admin-sidebar', { currentPath: '/admin/stores' }) %>

  <div class="flex-1 min-w-0">
    <%- include('../partials/admin-topbar', { pageTitle: 'Stores', pageSubtitle: stores.length + ' branches' }) %>

    <main class="p-8">
      <div class="grid md:grid-cols-2 gap-5">
        <% stores.forEach(function(s) { %>
          <div class="bg-white border border-mint-200 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="font-display text-lg font-semibold text-ink-900"><%= s.name %></h3>
              <% if (s.isMain) { %>
                <span class="px-2.5 py-1 rounded-capsule bg-gold-500/10 text-gold-500 text-xs font-bold">Main Branch</span>
              <% } %>
            </div>
            <div class="space-y-2 text-sm">
              <p class="text-ink-900/70"><strong class="text-ink-900">Address:</strong> <%= s.address %></p>
              <p class="text-ink-900/70"><strong class="text-ink-900">Phone:</strong> <%= s.phone %></p>
              <% if (s.hours) { %><p class="text-ink-900/70"><strong class="text-ink-900">Hours:</strong> <%= s.hours %></p><% } %>
            </div>
          </div>
        <% }); %>
      </div>
    </main>
  </div>
</div>
</body>
</html>