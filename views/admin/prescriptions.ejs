<%- include('../partials/header') %>

<body class="bg-mint-50">
<div class="flex">
  <%- include('../partials/admin-sidebar', { currentPath: '/admin/prescriptions' }) %>

  <div class="flex-1 min-w-0">
    <%- include('../partials/admin-topbar', { pageTitle: 'Prescriptions', pageSubtitle: prescriptions.length + ' submissions' }) %>

    <main class="p-8">
      <div class="bg-white border border-mint-200 rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-mint-50 border-b border-mint-200">
            <tr class="text-left text-ink-900/60 text-xs uppercase tracking-wide">
              <th class="px-5 py-3 font-semibold">Patient</th>
              <th class="px-5 py-3 font-semibold">Contact</th>
              <th class="px-5 py-3 font-semibold">Type</th>
              <th class="px-5 py-3 font-semibold">Status</th>
              <th class="px-5 py-3 font-semibold">Date</th>
              <th class="px-5 py-3 font-semibold text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-mint-200">
            <% if (prescriptions.length === 0) { %>
              <tr><td colspan="6" class="px-5 py-8 text-center text-ink-900/40">No prescriptions submitted yet.</td></tr>
            <% } %>
            <% prescriptions.forEach(function(p) { %>
              <tr class="hover:bg-mint-50/50 transition-colors">
                <td class="px-5 py-3.5 font-medium text-ink-900"><%= p.fullName %></td>
                <td class="px-5 py-3.5 text-ink-900/70"><%= p.phone %></td>
                <td class="px-5 py-3.5 text-ink-900/70"><%= p.fileUrl ? 'File Upload' : 'Typed' %></td>
                <td class="px-5 py-3.5">
                  <span class="px-2.5 py-1 rounded-capsule bg-gold-500/10 text-gold-500 text-xs font-semibold capitalize"><%= p.status %></span>
                </td>
                <td class="px-5 py-3.5 text-ink-900/50"><%= new Date(p.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                <td class="px-5 py-3.5 text-right">
                  <% if (p.fileUrl) { %>
                    <a href="<%= p.fileUrl %>" target="_blank" class="text-forest-700 font-medium hover:text-ink-900">View File</a>
                  <% } else { %>
                    <span class="text-ink-900/30">—</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</div>
</body>
</html>