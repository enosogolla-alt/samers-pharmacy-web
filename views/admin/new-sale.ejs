<%- include('../partials/header') %>

<body class="bg-mint-50">
<div class="flex">
  <%- include('../partials/admin-sidebar', { currentPath: '/admin/orders' }) %>

  <div class="flex-1 min-w-0">
    <%- include('../partials/admin-topbar', { pageTitle: 'New In-Store Sale', pageSubtitle: 'Record a walk-in counter purchase' }) %>

<main class="p-8 max-w-3xl" x-data='{
      lines: [{ productId: "", productName: "", qty: 1 }],
     allProducts: <%- JSON.stringify(products.map(p => ({ id: p.id, name: p.name, price: p.price, stock: p.stock }))).replace(/'/g, '&#39;') %>,
      addLine() { this.lines.push({ productId: "", productName: "", qty: 1 }) },
      removeLine(i) { this.lines.splice(i, 1) }
    }'>

      <form action="/admin/orders/new-sale" method="POST" class="space-y-6">

        <div class="bg-white border border-mint-200 rounded-2xl p-6">
          <h2 class="font-display text-lg font-semibold text-ink-900 mb-5">Items</h2>

          <template x-for="(line, index) in lines" :key="index">
            <div class="flex gap-3 mb-3 items-start" x-data="{ query: '', open: false }">
              <div class="relative flex-1">
                <input
                  type="text"
                  x-model="query"
                  @focus="open = true"
                  @click.outside="open = false"
                  @keydown.enter.prevent
                  placeholder="Search product name..."
                  x-bind:value="line.productName || query"
                  @input="line.productName = ''; line.productId = ''"
                  class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20"
                >
                <input type="hidden" :name="'productId_' + index" :value="line.productId">

                <div x-show="open" x-cloak class="absolute z-20 mt-1 w-full max-h-56 overflow-y-auto bg-white border border-mint-200 rounded-xl shadow-lg">
                  <template x-for="p in allProducts.filter(p => query === '' || p.name.toLowerCase().includes(query.toLowerCase()))" :key="p.id">
                    <button
                      type="button"
                      @click="line.productId = p.id; line.productName = p.name; query = ''; open = false"
                      class="w-full text-left px-4 py-2.5 text-sm hover:bg-mint-50 flex justify-between items-center"
                    >
                      <span x-text="p.name"></span>
                      <span class="text-ink-900/40 text-xs" x-text="'KSh ' + p.price.toLocaleString() + ' · Stock: ' + p.stock"></span>
                    </button>
                  </template>
                </div>
              </div>
              <input type="number" :name="'qty_' + index" x-model="line.qty" min="1" required class="w-24 px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20">
              <button type="button" @click="removeLine(index)" x-show="lines.length > 1" class="p-2.5 text-coral-500 hover:bg-coral-500/10 rounded-xl">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
          </template>

          <input type="hidden" name="lineCount" :value="lines.length">

          <button type="button" @click="addLine()" class="text-forest-700 font-medium text-sm hover:text-ink-900 flex items-center gap-1.5 mt-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            Add Another Item
          </button>
        </div>

        <div class="bg-white border border-mint-200 rounded-2xl p-6">
          <h2 class="font-display text-lg font-semibold text-ink-900 mb-5">Payment</h2>
          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-ink-900 mb-1.5">Payment Method</label>
              <select name="paymentMethod" required class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20">
                <option value="cash">Cash</option>
                <option value="mpesa">M-Pesa</option>
                <option value="card">Card</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-ink-900 mb-1.5">Served By</label>
              <input type="text" name="servedBy" required value="<%= currentUser.name %>" class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20">
            </div>
          </div>
        </div>

        <button type="submit" class="px-6 py-3 rounded-capsule bg-forest-700 text-white font-semibold hover:bg-ink-900 transition-colors">
          Complete Sale
        </button>
      </form>

    </main>
  </div>
</div>
</body>
</html>