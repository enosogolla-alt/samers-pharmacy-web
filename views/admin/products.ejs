<%- include('../partials/header') %>

<body class="bg-mint-50">
<div class="flex">
  <%- include('../partials/admin-sidebar', { currentPath: '/admin/products' }) %>

  <div class="flex-1 min-w-0">
    <%- include('../partials/admin-topbar', { pageTitle: 'Products', pageSubtitle: products.length + ' products in inventory' }) %>

    <main class="p-8">

      <div class="flex items-center justify-between mb-6">
        <div class="relative max-w-sm w-full">
          <svg class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-900/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" placeholder="Search products..." class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-mint-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20">
        </div>
        <a href="/admin/products/new" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-forest-700 text-white text-sm font-semibold hover:bg-ink-900 transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          Add Product
        </a>
      </div>

      <div class="bg-white border border-mint-200 rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-mint-50 border-b border-mint-200">
            <tr class="text-left text-ink-900/60 text-xs uppercase tracking-wide">
              <th class="px-5 py-3 font-semibold">Product</th>
              <th class="px-5 py-3 font-semibold">Category</th>
              <th class="px-5 py-3 font-semibold">Price</th>
              <th class="px-5 py-3 font-semibold">Stock</th>
              <th class="px-5 py-3 font-semibold">Expiry</th>
              <th class="px-5 py-3 font-semibold">Status</th>
              <th class="px-5 py-3 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-mint-200">
            <% products.forEach(function(p) { %>
              <tr class="hover:bg-mint-50/50 transition-colors">
                <td class="px-5 py-3.5">
                  <p class="font-medium text-ink-900"><%= p.name %></p>
                  <% if (p.batchNumber) { %><p class="text-xs text-ink-900/40">Batch: <%= p.batchNumber %></p><% } %>
                </td>
                <td class="px-5 py-3.5 text-ink-900/70"><%= p.category ? p.category.name : '—' %></td>
                <td class="px-5 py-3.5 text-ink-900/70">KSh <%= p.price.toLocaleString() %></td>
                <td class="px-5 py-3.5">
                  <span class="<%= p.stock <= p.reorderLevel ? 'text-coral-500 font-semibold' : 'text-ink-900/70' %>">
                    <%= p.stock %>
                  </span>
                  <% if (p.stock <= p.reorderLevel) { %>
                    <span class="ml-1.5 px-1.5 py-0.5 rounded-capsule bg-coral-500/10 text-coral-500 text-[10px] font-bold">LOW</span>
                  <% } %>
                </td>
                <td class="px-5 py-3.5 text-ink-900/70">
                  <% if (p.expiryDate) { %>
                    <%= new Date(p.expiryDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  <% } else { %>—<% } %>
                </td>
                <td class="px-5 py-3.5">
                  <% if (p.isActive) { %>
                    <span class="px-2.5 py-1 rounded-capsule bg-forest-700/10 text-forest-700 text-xs font-semibold">Active</span>
                  <% } else { %>
                    <span class="px-2.5 py-1 rounded-capsule bg-ink-900/10 text-ink-900/50 text-xs font-semibold">Inactive</span>
                  <% } %>
                </td>
               <td class="px-5 py-3.5 text-right" x-data="{ adjustOpen: false }">
                  <button @click="adjustOpen = true" class="text-forest-700 font-medium hover:text-ink-900 mr-3">Adjust Stock</button>
                  <a href="/admin/products/<%= p.id %>/edit" class="text-forest-700 font-medium hover:text-ink-900">Edit</a>

                  <div x-show="adjustOpen" x-cloak class="fixed inset-0 bg-ink-900/50 z-50 flex items-center justify-center p-4" @click.self="adjustOpen = false">
                    <div class="bg-white rounded-2xl p-6 max-w-sm w-full">
                      <h3 class="font-display text-lg font-semibold text-ink-900 mb-1">Adjust Stock</h3>
                      <p class="text-sm text-ink-900/60 mb-5"><%= p.name %> &middot; Current: <strong><%= p.stock %></strong></p>

                      <form action="/admin/products/<%= p.id %>/adjust-stock" method="POST">
                        <div class="mb-4">
                          <label class="block text-sm font-medium text-ink-900 mb-1.5">Reason</label>
                          <select name="reason" required class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20">
                            <option value="restock">Restock</option>
                            <option value="correction">Correction</option>
                            <option value="damaged">Damaged</option>
                            <option value="expired">Expired</option>
                            <option value="sale">In-store Sale</option>
                          </select>
                        </div>
                        <div class="mb-4">
                          <label class="block text-sm font-medium text-ink-900 mb-1.5">New Stock Quantity</label>
                          <input type="number" name="newQty" required min="0" value="<%= p.stock %>" class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20">
                        </div>
                        <div class="mb-5">
                          <label class="block text-sm font-medium text-ink-900 mb-1.5">Note <span class="text-ink-900/40 font-normal">(optional)</span></label>
                          <input type="text" name="note" class="w-full px-4 py-2.5 rounded-xl border border-mint-200 text-sm focus:outline-none focus:ring-2 focus:ring-forest-700/20">
                        </div>
                        <div class="flex gap-3">
                          <button type="submit" class="flex-1 py-2.5 rounded-capsule bg-forest-700 text-white text-sm font-semibold hover:bg-ink-900 transition-colors">Save</button>
                          <button type="button" @click="adjustOpen = false" class="flex-1 py-2.5 rounded-capsule border border-mint-200 text-ink-900/70 text-sm font-semibold">Cancel</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    </main>
  </div>
</div>
</body>
</html>