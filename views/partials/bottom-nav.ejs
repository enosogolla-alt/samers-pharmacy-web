<!-- ============ MOBILE BOTTOM TAB BAR ============ -->
<nav
  x-data="{
    path: window.location.pathname,
    isActive(match) {
      return match === '/' ? this.path === '/' : this.path.startsWith(match);
    }
  }"
  class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-mint-200 shadow-[0_-4px_20px_rgba(26,15,46,0.08)]"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <div class="grid grid-cols-5 pt-2">
    <a
      href="/"
      class="flex flex-col items-center justify-center gap-1 pb-2"
      :class="isActive('/') ? 'text-forest-700' : 'text-ink-900/40'"
    >
      <svg class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" :stroke-width="isActive('/') ? 2 : 1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1V9.5z" />
      </svg>
      <span class="text-[10px] leading-none" :class="isActive('/') ? 'font-bold' : 'font-medium'">Home</span>
    </a>

    <a
      href="/deals"
      class="flex flex-col items-center justify-center gap-1 pb-2"
      :class="isActive('/deals') ? 'text-forest-700' : 'text-ink-900/40'"
    >
      <svg class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" :stroke-width="isActive('/deals') ? 2 : 1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      <span class="text-[10px] leading-none" :class="isActive('/deals') ? 'font-bold' : 'font-medium'">Offers</span>
    </a>

    <a href="/cart" class="relative flex flex-col items-center justify-center gap-0.5">
      <span x-show="isActive('/cart')" class="absolute -top-2 w-11 h-[3px] rounded-full bg-forest-700"></span>
      <span
        class="relative flex items-center justify-center w-10 h-10 rounded-2xl -mt-3.5 transition-colors"
        :class="isActive('/cart') ? 'bg-forest-700 shadow-lg shadow-forest-700/30' : 'bg-mint-50'"
      >
        <svg class="w-[19px] h-[19px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.9" :class="isActive('/cart') ? 'text-white' : 'text-forest-700'">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.5l.9 4.5m0 0L6.6 15.6a1.5 1.5 0 001.48 1.4h9.35a1.5 1.5 0 001.48-1.24l1.13-6.26H4.65M7.5 19.5a1 1 0 100 2 1 1 0 000-2zm10 0a1 1 0 100 2 1 1 0 000-2z" />
        </svg>
        <span
          data-cart-badge
          class="absolute -top-1 -right-1 w-4 h-4 min-w-[16px] px-0.5 rounded-full bg-coral-500 text-white text-[9px] font-bold items-center justify-center border-2 border-white"
          style="display: none"
        ></span>
      </span>
      <span class="text-[10px] leading-none pb-2" :class="isActive('/cart') ? 'text-forest-700 font-bold' : 'text-ink-900/40 font-medium'">Cart</span>
    </a>

    <a
      href="/prescription"
      class="flex flex-col items-center justify-center gap-1 pb-2"
      :class="isActive('/prescription') ? 'text-forest-700' : 'text-ink-900/40'"
    >
      <svg class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" :stroke-width="isActive('/prescription') ? 2 : 1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 16v-6m0 0l-2.5 2.5M12 10l2.5 2.5" />
      </svg>
      <span class="text-[10px] leading-none" :class="isActive('/prescription') ? 'font-bold' : 'font-medium'">Prescription</span>
    </a>

    <a
      href="/consultation"
      class="flex flex-col items-center justify-center gap-1 pb-2"
      :class="isActive('/consultation') ? 'text-forest-700' : 'text-ink-900/40'"
    >
      <svg class="w-[22px] h-[22px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" :stroke-width="isActive('/consultation') ? 2 : 1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3a7 7 0 00-7 7v4a2 2 0 002 2h1v-6H5v-1a7 7 0 0114 0v1h-3v6h1a2 2 0 002-2v-4a7 7 0 00-7-7z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16v1a3 3 0 01-3 3h-1" />
      </svg>
      <span class="text-[10px] leading-none" :class="isActive('/consultation') ? 'font-bold' : 'font-medium'">Consult</span>
    </a>
  </div>
</nav>

<div class="md:hidden h-16" style="padding-bottom: env(safe-area-inset-bottom);"></div>
