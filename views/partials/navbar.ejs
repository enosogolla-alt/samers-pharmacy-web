<style>
  @keyframes marquee-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  .marquee-track {
    animation: marquee-scroll 22s linear infinite;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
</style>

<div
  x-data="{
    mobileMenuOpen: false,
    mobileSearchOpen: false,
    scrolled: false,
    transparentNav: <%= typeof transparentNav !== 'undefined' && transparentNav ? 'true' : 'false' %>
  }"
  x-init="window.addEventListener('scroll', () => { scrolled = window.scrollY > 40 })"
  x-cloak
  class="sticky top-0 z-50"
>
<script>
  function searchBox() {
    return {
      q: '',
      results: [],
      open: false,
      loading: false,
      debounceTimer: null,
      onInput() {
        clearTimeout(this.debounceTimer);
        const query = this.q.trim();
        if (!query) {
          this.results = [];
          this.open = false;
          return;
        }
        this.debounceTimer = setTimeout(() => this.fetchSuggestions(query), 250);
      },
      async fetchSuggestions(query) {
        this.loading = true;
        try {
          const res = await fetch('/api/products/suggest?q=' + encodeURIComponent(query));
          this.results = await res.json();
          this.open = true;
        } catch (e) {
          this.results = [];
        } finally {
          this.loading = false;
        }
      },
      close() {
        this.open = false;
      }
    }
  }
</script>
<!-- Moving offer strip -->
  <div class="bg-gold-500 text-ink-900 overflow-hidden whitespace-nowrap py-2">
    <div class="marquee-track inline-flex gap-16 text-sm font-semibold">
